{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skyvision-dashboard",
  "main": "src/index.ts",
  "build": {
    "command": "npm run build",
    "watch_dir": ["ui", "src", "../shared/src", "vite.config.ts", "openapi.json"]
  },
  "compatibility_date": "2026-09-01",
  // Your hosts and account IDs are not in this file: "" values, and bindings without IDs, are filled
  // from your environment or .env into wrangler.deploy.json (../shared/deploy-config.mjs). The
  // website, at SITE_HOST, uses Cloudflare Access; API_HOST serves only the bearer-key API. Both are
  // custom domains. No workers.dev or preview URLs. The Worker rejects website routes on the API host.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *"] },
  "durable_objects": { "bindings": [{ "name": "RUN_SESSIONS", "class_name": "WorkshopRunSession" }] },
  "migrations": [{ "tag": "v1-workshop-live", "new_sqlite_classes": ["WorkshopRunSession"] }],
  // Every request reaches the Worker: Access protects the website; bearer keys protect /v1.
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "r2_buckets": [
    { "binding": "MODELS", "bucket_name": "skyvision-models" },
    { "binding": "WORKSHOP", "bucket_name": "skyvision-workshop" }
  ],
  // Footage lives on the footage store host (external/store), reached through its Cloudflare Tunnel
  // and a Workers VPC service (STORE_SERVICE_ID). The store also makes Workshop thumbnails and agent
  // image previews. Secret, not in git: STORE_TOKEN (the store's ~/.config/skyvision-store/store.token).
  "vpc_services": [{ "binding": "STORE", "remote": true }],
  "d1_databases": [
    {
      "binding": "CATALOG",
      "database_name": "skyvision-catalog",
      "migrations_dir": "../../db/migrations"
    },
    {
      "binding": "API_KEYS",
      "database_name": "skyvision-catalog",
      "migrations_dir": "db/migrations",
      "migrations_table": "api_key_migrations"
    }
  ],
  "vars": {
    "CAMERAS": "",
    "API_HOST": "",
    // Your Access application's team domain (https://<team>.cloudflareaccess.com) and audience tag
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "env": {
    // Local inference environment: catalog, credentials and results are local. Only footage (STORE) is remote.
    "inference": {
      "routes": [],
      "vars": {
        "CAMERAS": "",
        "API_HOST": "",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "local-inference",
        "INFERENCE_ENABLED": "true"
      },
      "vpc_services": [{ "binding": "STORE", "remote": true }],
      "r2_buckets": [
        { "binding": "EVIDENCE", "bucket_name": "skyvision-evidence-local", "remote": false },
        { "binding": "MODELS", "bucket_name": "skyvision-models-local", "remote": false },
        { "binding": "WORKSHOP", "bucket_name": "skyvision-workshop-local", "remote": false }
      ],
      "d1_databases": [
        {
          "binding": "CATALOG",
          "database_name": "skyvision-inference-local",
          "database_id": "skyvision-inference-local",
          "migrations_dir": "../../db/migrations",
          "remote": false
        },
        {
          "binding": "API_KEYS",
          "database_name": "skyvision-inference-keys-local",
          "database_id": "skyvision-inference-keys-local",
          "migrations_dir": "db/migrations",
          "migrations_table": "api_key_migrations",
          "remote": false
        }
      ]
    },
    // npm run start: the Worker runs on this machine; STORE, R2 and D1 calls go to the real resources.
    // Footage/catalog reads are remote; development keys are isolated in local D1.
    // Bindings are not inherited by environments, so they are repeated.
    "dev": {
      "routes": [],
      "vars": {
        "CAMERAS": "",
        "API_HOST": "",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": ""
      },
      "r2_buckets": [
        { "binding": "MODELS", "bucket_name": "skyvision-models", "remote": true },
        { "binding": "WORKSHOP", "bucket_name": "skyvision-workshop", "remote": true }
      ],
      "vpc_services": [{ "binding": "STORE", "remote": true }],
      "d1_databases": [
        {
          "binding": "CATALOG",
          "database_name": "skyvision-catalog",
          "migrations_dir": "../../db/migrations",
          "remote": true
        },
        {
          "binding": "API_KEYS",
          "database_name": "skyvision-api-keys-dev",
          "database_id": "skyvision-api-keys-local",
          "migrations_dir": "db/migrations",
          "migrations_table": "api_key_migrations",
          "remote": false
        }
      ]
    }
  }
}
