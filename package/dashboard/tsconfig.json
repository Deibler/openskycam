{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./ui/*"]
    }
  },
  "include": ["src", "../shared"]
}
